# /etc/mcp-server.env  —  copy to /etc/mcp-server.env, chmod 600, chown root:root
# Every value below is a placeholder. Nothing here should be committed to git.

# ── required ────────────────────────────────────────────────────────────────
# Long random access key. Generate: openssl rand -hex 32
MCP_TOKEN=CHANGE_ME_64_HEX
# Public https origin the client will reach (no trailing slash). Needed for OAuth metadata.
MCP_PUBLIC_BASE=https://mcp.example.com
# Folder of markdown files this server exposes.
KB_DIR=/opt/mcp-server/kb

# ── recommended ─────────────────────────────────────────────────────────────
# Host allow-list (guards against Host-header/DNS-rebinding noise). "*." wildcards ok.
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_SERVICE_NAME=knowledge-base
MCP_DISPLAY_NAME=Private MCP
# Bind address: keep 127.0.0.1 when a tunnel (cloudflared/ngrok) fronts it.
HOST=127.0.0.1
PORT=8081
MCP_PATH=/mcp

# ── optional ────────────────────────────────────────────────────────────────
# Separate throwaway key for URL-embedded access (/s/<slug>/mcp). Generate: openssl rand -hex 16
# Revoke by emptying it and restarting. Never put MCP_TOKEN in a URL.
#MCP_SHARE_SLUG=
# Where OAuth client registrations / refresh tokens live (chmod 600, written by the service).
MCP_OAUTH_STATE=/var/lib/mcp-oauth/oauth_state.json
MCP_OAUTH_SCOPE=mcp.read

# Cloudflare Access in front of /authorize only -> keyless browser authorization.
# Team name is the prefix of <team>.cloudflareaccess.com. AUD = the Access app's audience tag.
#MCP_CF_ACCESS_TEAM=
#MCP_CF_ACCESS_AUD=

# ── indexing (optional) ─────────────────────────────────────────────────────
# Credential-shaped documents stay out of the index even when they sit inside KB_DIR —
# pointing this server at a real notes vault should not publish its recovery codes.
# Directories (comma-separated, relative to KB_DIR, matched at any depth) to skip:
#KB_EXCLUDE_DIRS=private,secrets
# Filename globs (comma-separated, case-insensitive). Defaults already cover
#   *recovery-code* *secret* *credential* *password* *.env *token*.md *apikey* *private-key*
#KB_EXCLUDE_GLOBS=*recovery-code*,*secret*,*token*.md,*.env
# Skip files larger than this when indexing, in bytes. Default 2 MiB.
#KB_MAX_DOC_BYTES=2097152
# Reuse the parsed index for this many seconds when the tree is unchanged.
# Without a cache, every search re-reads every markdown file. Default 3.
#KB_CACHE_TTL=3

# ── write tool (optional) ───────────────────────────────────────────────────
# off   (default) — strictly read-only. A server that cannot write cannot be talked into it.
# inbox           — additionally expose submit_doc, whose writes can only ever land in
#                   KB_INBOX_DIR: no directory parameter, sanitised filename, and the
#                   resolved path is asserted to sit directly inside the inbox.
#KB_WRITE_MODE=inbox
# The one folder MCP submissions land in (created on demand). Reports/notes land here for
# you to review and file; the server can never write anywhere else.
#KB_INBOX_DIR=inbox
# Max bytes accepted by submit_doc. Default 512 KiB.
#KB_MAX_WRITE_BYTES=524288

# Frontmatter written into submitted documents. The defaults are generic (source: mcp,
# no type). Map them onto whatever your vault validates — for example a wiki whose linter
# only accepts source ∈ {ai,wechat,manual,import,obsidian} and requires an explicit type:
#   KB_INBOX_SOURCE=ai  KB_INBOX_TYPE=inbox  KB_INBOX_STATUS=raw
#KB_INBOX_SOURCE=mcp
#KB_INBOX_TYPE=
#KB_INBOX_STATUS=raw
