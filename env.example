# /etc/mcp-server.env  —  copy to /etc/mcp-server.env, chmod 600, chown root:root
# Every value below is a placeholder. Nothing here should be committed to git.

# ── required ────────────────────────────────────────────────────────────────
# Long random access key. Generate: openssl rand -hex 32
MCP_TOKEN=CHANGE_ME_64_HEX
# Public https origin the client will reach (no trailing slash). Needed for OAuth metadata.
MCP_PUBLIC_BASE=https://mcp.example.com
# Folder of markdown files this server exposes.
KB_DIR=/opt/mcp-server/kb

# ── recommended ─────────────────────────────────────────────────────────────
# Host allow-list (guards against Host-header/DNS-rebinding noise). "*." wildcards ok.
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_SERVICE_NAME=knowledge-base
MCP_DISPLAY_NAME=Private MCP
# Bind address: keep 127.0.0.1 when a tunnel (cloudflared/ngrok) fronts it.
HOST=127.0.0.1
PORT=8081
MCP_PATH=/mcp

# ── optional ────────────────────────────────────────────────────────────────
# Separate throwaway key for URL-embedded access (/s/<slug>/mcp). Generate: openssl rand -hex 16
# Revoke by emptying it and restarting. Never put MCP_TOKEN in a URL.
#MCP_SHARE_SLUG=
# Where OAuth client registrations / refresh tokens live (chmod 600, written by the service).
MCP_OAUTH_STATE=/var/lib/mcp-oauth/oauth_state.json
MCP_OAUTH_SCOPE=mcp.read

# Cloudflare Access in front of /authorize only -> keyless browser authorization.
# Team name is the prefix of <team>.cloudflareaccess.com. AUD = the Access app's audience tag.
#MCP_CF_ACCESS_TEAM=
#MCP_CF_ACCESS_AUD=
